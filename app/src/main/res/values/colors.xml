    <color name="widget_bg">#FFFEFA</color>
    <color name="widget_line">#E9E8DF</color>
    <color name="widget_ink">#20221B</color>
    <color name="widget_muted">#85877C</color>
    <color name="widget_accent">#C7F36B</color>
    <color name="widget_ring">#C5C6B8</color>
