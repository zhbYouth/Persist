<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- StartingTheme：启动窗口（系统启动页）；onCreate 里再切换为 AppTheme
             singleTask：点小组件回到应用时复用已有窗口，不再重新加载页面
             adjustResize：Android 10 及以下靠它避让键盘；Android 11+ 由原生逐帧同步键盘高度 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/StartingTheme"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 小组件只接收系统广播和本应用自己的 PendingIntent，不需要对外暴露 -->
        <receiver android:name=".ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.riheng.app.ACTION_DAILY_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <service android:name=".HabitWidgetService" android:exported="false" android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver android:name=".HabitWidgetProvider" android:exported="false" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/habit_widget_info" />
        </receiver>
    </application>
</manifest>
