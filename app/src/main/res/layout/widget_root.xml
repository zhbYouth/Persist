<?xml version="1.0" encoding="utf-8"?>
<!-- 注意：这里的 dp 数值与 HabitWidgetProvider.kt 中的 CHROME_HEIGHT_DP 联动：
     上下内边距 12+12，标题行 24，进度行 18 + 下边距 4，底部入口 20，合计 90dp。改动时两边一起改。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Persist"
            android:textColor="@color/widget_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widgetDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日计划"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetProgress"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="已完成 0 / 0 项"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widgetRows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widgetOpen"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:text="打开 Persist ↗"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
