<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/widgetHeader"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="成事"
            android:textColor="@color/widget_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widgetDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日计划"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetProgress"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="已完成 0 / 0 项"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/widgetList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/widgetOpen"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:text="打开成事 ↗"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
