<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66101828"
    android:focusable="true"
    android:focusableInTouchMode="true">
    <LinearLayout
        android:id="@+id/qaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/qa_card"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="添加待办"
                android:textColor="@color/widget_ink"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/qaClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/qa_chip_off"
                android:contentDescription="关闭"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/widget_muted"
                android:textSize="20sp" />
        </LinearLayout>
        <EditText
            android:id="@+id/qaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@null"
            android:hint="要做什么？"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="120"
            android:maxLines="1"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/widget_ink"
            android:textColorHint="@color/widget_muted"
            android:textSize="17sp"
            android:textStyle="bold" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_line" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qaPending"
                style="@style/QaChip"
                android:text="待确定" />
            <TextView
                android:id="@+id/qaToday"
                style="@style/QaChip"
                android:layout_marginStart="6dp"
                android:text="今天" />
            <TextView
                android:id="@+id/qaFuture"
                style="@style/QaChip"
                android:layout_marginStart="6dp"
                android:text="未来" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/qaMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qaDate"
                style="@style/QaChip"
                android:text="选择日期" />
            <TextView
                android:id="@+id/qaTime"
                style="@style/QaChip"
                android:layout_marginStart="6dp"
                android:text="提醒时间" />
            <TextView
                android:id="@+id/qaRepeat"
                style="@style/QaChip"
                android:layout_marginStart="6dp"
                android:text="不重复" />
        </LinearLayout>
        <TextView
            android:id="@+id/qaSave"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/qa_save"
            android:gravity="center"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
